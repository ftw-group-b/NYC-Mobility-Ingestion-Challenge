            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "700b943a",
      "displayName": "Zone Anomaly Hotspots",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  zone_name,\r\n  CASE \r\n    WHEN borough IN ('N/A', 'Unknown', 'Unknown Borough') OR borough IS NULL \r\n      THEN 'Unmapped / Out of Area'\r\n    ELSE borough \r\n  END AS borough,\r\n  total_pickups,\r\n  flagged_pickups,\r\n  flagged_pct\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_zone_hotspots\r\nWHERE total_pickups >= 100\r\nORDER BY flagged_pct DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "9e3b70c6",
      "displayName": "Referential Integrity Metrics for Taxi Trip Data Analysis",
      "queryLines": [
        "SELECT\n",
        "  trip_key,\n",
        "  pickup_datetime,\n",
        "  dropoff_datetime,\n",
        "  pickup_taxi_zone_key,\n",
        "  dropoff_taxi_zone_key,\n",
        "  dq_zero_trip_distance,\n",
        "  dq_extreme_trip_distance,\n",
        "  dq_negative_trip_distance,\n",
        "  dq_invalid_trip_duration,\n",
        "  dq_missing_weather_coverage,\n",
        "  dq_unmapped_pickup_zone,\n",
        "  dq_null_trip_key,\n",
        "  dq_duplicate_trip_key,\n",
        "  source_file,\n",
        "  batch_id\n",
        "FROM\n",
        "  `ftw-week-08`.`03_gold`.dq_dashboard_problem_areas\n",
        "LIMIT 1000"
      ]
    },
    {
      "name": "f181fead",
      "displayName": "Foreign Key Orphan Checks",
      "config": {
        "version": "1.1",
        "source": "SELECT 'dim_date (Pickup)' AS dimension_table, missing_pickup_date_keys AS missing_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_date (Dropoff)', missing_dropoff_date_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_time (Pickup)', missing_pickup_time_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_time (Dropoff)', missing_dropoff_time_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_taxi_zone (Pickup)', missing_pickup_zone_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_taxi_zone (Dropoff)', missing_dropoff_zone_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\nUNION ALL SELECT 'dim_weather_hour', missing_weather_keys FROM `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
