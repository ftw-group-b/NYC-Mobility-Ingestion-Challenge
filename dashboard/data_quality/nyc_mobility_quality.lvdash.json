{
  "datasets": [
    {
      "name": "bbd16020",
      "displayName": "Timestamp",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  concat(\r\n    'Refreshed: ',\r\n    date_format(\r\n      from_utc_timestamp(current_timestamp(), 'Asia/Manila'),\r\n      'MMMM dd, yyyy hh:mm a'\r\n    )\r\n  ) AS last_refreshed",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "9f7cb49a",
      "displayName": "DQ-Checks",
      "queryLines": [
        "SELECT\n",
        "  check_name,\n",
        "  quality_dimension,\n",
        "  flagged_rows,\n",
        "  total_rows,\n",
        "  flagged_pct\n",
        "FROM\n",
        "  `ftw-week-08`.`03_gold`.dq_dashboard_check_scores\n",
        "ORDER BY\n",
        "  flagged_rows DESC"
      ]
    },
    {
      "name": "6ec2a3c0",
      "displayName": "Referential Integrity Overview",
      "queryLines": [
        "SELECT\n",
        "  missing_pickup_date_keys,\n",
        "  missing_dropoff_date_keys,\n",
        "  missing_pickup_time_keys,\n",
        "  missing_dropoff_time_keys,\n",
        "  missing_pickup_zone_keys,\n",
        "  missing_dropoff_zone_keys,\n",
        "  missing_weather_keys,\n",
        "  joined_rows,\n",
        "  fact_rows,\n",
        "  join_row_difference\n",
        "FROM\n",
        "  `ftw-week-08`.`03_gold`.dq_dashboard_referential_integrity"
      ]
    },
    {
      "name": "9bdd8548",
      "displayName": "Clean Record Rate",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  clean_row_pct,\r\n  clean_rows,\r\n  total_rows,\r\n  rows_with_any_dq_flag,\r\n  last_checked_at\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_overview\r\n",
        "dimensions": [
          {
