      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  check_name,\r\n  quality_dimension,\r\n  flagged_rows,\r\n  flagged_pct\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_check_scores\r\nWHERE flagged_rows > 0\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
