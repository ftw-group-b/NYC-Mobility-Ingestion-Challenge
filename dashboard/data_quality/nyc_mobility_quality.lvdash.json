    },
    {
      "name": "0f6d0aee",
      "displayName": "Clean vs. Flagged Split",
      "config": {
        "version": "1.1",
        "source": "SELECT \r\n  'Clean Records' AS record_status, \r\n  clean_rows AS record_count\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_overview\r\n\r\nUNION ALL\r\n\r\nSELECT \r\n  'Flagged Records' AS record_status, \r\n  rows_with_any_dq_flag AS record_count\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_overview\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
