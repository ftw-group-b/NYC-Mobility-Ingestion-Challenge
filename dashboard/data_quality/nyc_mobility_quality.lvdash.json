      }
    },
    {
      "name": "7faddbfa",
      "displayName": "Critical Integrity Failures",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  (rows_with_orphaned_fk + null_trip_key_count) AS critical_integrity_failures,\r\n  rows_with_orphaned_fk AS orphaned_foreign_keys,\r\n  null_trip_key_count AS null_primary_keys\r\nFROM `ftw-week-08`.`03_gold`.dq_dashboard_overview\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
